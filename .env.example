# ─── Hygie Environment Variables ─────────────────────────────────────────────
# Copy to .env and set your values. Required = must be set for production.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/app/data/hygie.db
# MariaDB (optional) — when set, SQLite is not used
# DATABASE_URL=mysql+aiomysql://hygie:secret@mariadb:3306/hygie

# ─── Security ─────────────────────────────────────────────────────────────────
# [RECOMMENDED] Fernet key for encrypting API keys/webhooks at rest. Hygie
# starts without it (falls back to plaintext storage with a startup WARNING)
# but it should be set for any production deployment.
# Generate: python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
HYGIE_ENCRYPTION_KEY=

# [OPTIONAL] JWT signing key — auto-generated if not set (sessions lost on restart)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─── Workers ──────────────────────────────────────────────────────────────────
# [CRITICAL] Must be 1 unless DATABASE_URL points to MariaDB (SQLite does not
# support multiple workers — startup aborts). WORKERS>1 with MariaDB is
# supported and coordinates via advisory locks. See ARCHITECTURE.md for why.
WORKERS=1

# ─── Reverse proxy ────────────────────────────────────────────────────────────
# Recommended: CIDR/IP list (comma-separated) of your reverse proxy / tunnel network.
# Proxy headers (X-Forwarded-For, CF-Connecting-IP) are only honoured from these peers.
# docker/entrypoint.sh also passes it to uvicorn as --forwarded-allow-ips unless
# FORWARDED_ALLOW_IPS is set (effective trust = union of both).
# HYGIE_TRUSTED_PROXIES=172.27.0.0/16
# Legacy (deprecated, trusts any peer): set to 1 only behind a trusted reverse proxy.
# Ignored when HYGIE_TRUSTED_PROXIES is set.
HYGIE_TRUST_PROXY=0
# CORS allowed origins (comma-separated).
# Defaults to http://localhost:8000,http://localhost:5173 when not set.
# HYGIE_ALLOWED_ORIGINS=https://hygie.mydomain.com

# ─── Overlays ─────────────────────────────────────────────────────────────────
# Custom font path for poster overlays (auto-detected on Debian/Ubuntu/Alpine)
# HYGIE_FONT_PATH=/usr/share/fonts/TTF/DejaVuSans-Bold.ttf
